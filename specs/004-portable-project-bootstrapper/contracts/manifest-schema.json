{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecKitBootstrapManifest",
  "type": "object",
  "required": ["manifest_version", "bundle_version", "generated_at", "files"],
  "properties": {
    "manifest_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "bundle_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["digest", "size_bytes", "tier"],
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "tier": {
            "type": "string",
            "enum": ["core", "preset", "extension", "skill", "agent", "metadata"]
          }
        }
      }
    }
  }
}
